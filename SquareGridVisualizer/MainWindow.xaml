<Window x:Class="SquareGridVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Square Grid Visualizer" Height="700" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Controls -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="-" Width="30" Click="Decrease_Click"/>
            <TextBlock x:Name="NValueText" Width="30" TextAlignment="Center" Margin="5,0"/>
            <Button Content="+" Width="30" Click="Increase_Click"/>
            <Button Content="Draw Grid" Click="DrawGrid_Click" Margin="10,0"/>
            <Button Content="Export PNG" Click="ExportPng_Click" Margin="10,0"/>
            <TextBlock x:Name="ResultText" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Canvas inside ScrollViewer -->
        <ScrollViewer Grid.Row="1">
            <Canvas x:Name="GridCanvas" Background="Black"/>
        </ScrollViewer>
    </Grid>
</Window>
